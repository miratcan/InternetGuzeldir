# Google Sheets Excel export URL
SPREADSHEET_URL = "https://docs.google.com/spreadsheets/d/YOUR_SPREADSHEET_ID/pub?output=xlsx"

# Spreadsheet page names
SPREADSHEET_LINKS_PAGE_NAME = "Links"
