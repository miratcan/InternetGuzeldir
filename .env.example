SITE_DESC = "A curated link directory built from a spreadsheet"

# Timezone offset (hours from UTC) for link dates
TIMEZONE_HOURS = 3

# Minification (set to False to disable)
MINIMIZE_CSS = True
MINIMIZE_HTML = True
