{% extends "base.html.jinja2" %}
{% block title %}{{ link.title}} — {{ env.SITE_TITLE }}{% endblock title %}
{% block description %}{{ link.desc|e }}{% endblock %}
{% block main %}
  <article id='link_detail'>
    <div class='inner'>
      <h2 class='title'>{{ link.title }}</h2>
      <p class='url'><a class='link' href='{{ link.url }}'>{{ link.url|truncate(50, False, '...', 0) }}</a></p>
      <p class='desc'>{{ link.desc }}</p>
    </div>
    <p class='meta'>{{ link.lang }} dilinde bir {{ link.kind }}. {{ link.create_time.strftime('%d-%m-%Y') }} tarihinde eklenmiştir.{% if link.sender %} Gönderen: {{ link.sender }}.{% endif %}</p>
  </article>
{% endblock %}
